# Copy to .env.local and fill in.
#
# Local development with the Supabase CLI (`supabase start`) prints these values.
# For a hosted project, copy them from Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: only needed for privileged server tasks (e.g. an ingestion/scraper
# pipeline writing rows). The web app itself reads with the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
